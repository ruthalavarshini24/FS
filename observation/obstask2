        <!-- PART C & D: Forms & Modern HTML5 Input Types -->
        <section id="register">
            <h2>ANITS Admission Registration Form</h2>
            <form action="#" method="post">
                
                <!-- Full Name -->
                <p>
                    <label for="fullname">Student Full Name:</label><br>
                    <input type="text" id="fullname" name="fullname" placeholder="Enter full name" required>
                </p>

                <!-- PART D Input: Email -->
                <p>
                    <label for="email">Student Email ID:</label><br>
                    <input type="email" id="email" name="email" placeholder="student@anits.edu.in" required>
                </p>

                <!-- Password -->
                <p>
                    <label for="password">Create Password:</label><br>
                    <input type="password" id="password" name="password" required>
                </p>

                <!-- PART D Input: Date -->
                <p>
                    <label for="dob">Date of Birth:</label><br>
                    <input type="date" id="dob" name="dob">
                </p>

                <!-- PART D Input: Number -->
                <p>
                    <label for="eapcet_rank">AP EAPCET Rank:</label><br>
                    <input type="number" id="eapcet_rank" name="eapcet_rank" min="1" max="200000">
                </p>

                <!-- Gender (Radio Buttons) -->
                <p>
                    <label>Gender:</label><br>
                    <input type="radio" id="male" name="gender" value="Male">
                    <label for="male">Male</label>
                    <input type="radio" id="female" name="gender" value="Female">
                    <label for="female">Female</label>
                </p>

                <!-- Hobbies (Checkboxes) -->
                <p>
                    <label>Co-Curricular / Hobbies:</label><br>
                    <input type="checkbox" id="coding" name="hobbies" value="Coding">
                    <label for="coding">Coding Club</label>
                    <input type="checkbox" id="robotics" name="hobbies" value="Robotics">
                    <label for="robotics">e-Yantra Robotics</label>
                    <input type="checkbox" id="sports" name="hobbies" value="Sports">
                    <label for="sports">Sports & Athletics</label>
                </p>

                <!-- Branch (Dropdown) -->
                <p>
                    <label for="branch">Select Engineering Branch:</label><br>
                    <select id="branch" name="branch">
                        <option value="CSE">Computer Science & Engineering (CSE)</option>
                        <option value="CSM">CSE (AI & ML)</option>
                        <option value="ECE">Electronics & Communication (ECE)</option>
                        <option value="EEE">Electrical & Electronics (EEE)</option>
                        <option value="IT">Information Technology (IT)</option>
                        <option value="MECH">Mechanical Engineering</option>
                    </select>
                </p>

                <!-- PART D Input: Color -->
                <p>
                    <label for="fav_color">Preferred ID Card Theme Color:</label><br>
                    <input type="color" id="fav_color" name="fav_color" value="#003366">
                </p>

                <!-- PART D Input: Range -->
                <p>
                    <label for="satisfaction">Self Assessment Rating (1 to 10):</label><br>
                    <input type="range" id="satisfaction" name="satisfaction" min="1" max="10">
                </p>

                <!-- Comments (Textarea) -->
                <p>
                    <label for="comments">Additional Remarks / Address:</label><br>
                    <textarea id="comments" name="comments" rows="4" cols="50" placeholder="Enter address or questions..."></textarea>
                </p>

                <!-- Buttons -->
                <p>
                    <input type="submit" value="Submit Registration">
                    <input type="reset" value="Reset Form">
                </p>
            </form>
        </section>

